<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<TabPane prefHeight="520.0" prefWidth="900.0" tabClosingPolicy="UNAVAILABLE"
         xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="hu.unideb.inf.controller.MainController">
   <tabs>
      <Tab text="Felhasználók">
         <content>
            <fx:include fx:id="user" source="UserScene.fxml" />
         </content>
      </Tab>
      <Tab fx:id="logTab" text="Napló">
         <content>
            <fx:include fx:id="log" source="LogScene.fxml" />
         </content>
      </Tab>
   </tabs>
</TabPane>